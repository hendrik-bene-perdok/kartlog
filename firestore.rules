rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return (request.auth != null && request.auth.uid == userId) || userId == 'local-user-001';
    }

    // Helper to get current User ID safely (handling dev mode)
    function getCurrentUserId() {
      return request.auth != null ? request.auth.uid : 'local-user-001';
    }

    // Check if user is an active member of a team
    function isActiveMember(teamId) {
      let uid = getCurrentUserId();
      let memberDoc = get(/databases/$(database)/documents/teams/$(teamId)/members/$(uid));
      return memberDoc != null && memberDoc.data.status == 'active';
    }

    // Check if user is owner of a team
    function isTeamOwner(teamId) {
      let team = get(/databases/$(database)/documents/teams/$(teamId));
      let uid = getCurrentUserId();
      return team != null && team.data.ownerId == uid;
    }

    // Check if user is admin or owner
    function isAdminOrOwner(teamId) {
      let uid = getCurrentUserId();
      let memberDoc = get(/databases/$(database)/documents/teams/$(teamId)/members/$(uid));
      return memberDoc != null && 
             memberDoc.data.status == 'active' && 
             (memberDoc.data.role == 'admin' || memberDoc.data.role == 'owner');
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isAuthenticated() || userId == 'local-user-001';
    }

    // --- Teams Collection ---
    match /teams/{teamId} {
      // Allow reading if member OR if team has an active invite code (needed for invite links)
      // Note: This makes team metadata (name, desc) visible to authenticated users if they can guess/query the code.
      // Subcollections are still protected.
      allow get: if isActiveMember(teamId) || (resource.data.inviteCode != null && resource.data.inviteCode != "");
      allow list: if isActiveMember(teamId) || (resource.data.inviteCode != null && resource.data.inviteCode != "");
      
      allow create: if isAuthenticated() || request.resource.data.ownerId == 'local-user-001';
      allow update: if isAdminOrOwner(teamId);
      allow delete: if isTeamOwner(teamId);

      // --- Members Sub-collection ---
      match /members/{memberId} {
        // Allow active members to read list, OR user to read their own status (pending/rejected)
        allow read: if isActiveMember(teamId) || memberId == getCurrentUserId();
        
        // Allow creating a join request (pending member) for oneself
        // OR allow creator to add themselves as owner/active if they own the team
        allow create: if (isAuthenticated() || memberId == 'local-user-001') && memberId == getCurrentUserId() && 
          (
            request.resource.data.status == 'pending' || 
            (isTeamOwner(teamId) && request.resource.data.role == 'owner' && request.resource.data.status == 'active')
          );
        
        // Only Admin/Owner can update members (approve, change role)
        // Self-update removed to prevent self-approval
        allow update: if isAdminOrOwner(teamId);
        
        // Allow Admin/Owner to remove members, OR user to leave (delete own doc)
        allow delete: if isAdminOrOwner(teamId) || memberId == getCurrentUserId();
      }

      // --- Lists Sub-collection ---
      match /lists/{listId}/items/{itemId} {
        allow read, write: if isActiveMember(teamId);
      }

      // --- Chat Sub-collection ---
      match /chat/{messageId} {
        allow read: if isActiveMember(teamId);
        allow create: if isActiveMember(teamId);
        allow delete: if isTeamOwner(teamId); // Only owner can delete messages
      }

      // --- Parts Sub-collection (existing) ---
      match /parts/{partId} {
        allow read: if isActiveMember(teamId);
        allow write: if isActiveMember(teamId);
      }

      // --- Sessions Sub-collection (existing) ---
      match /sessions/{sessionId} {
        allow read: if isActiveMember(teamId);
        allow write: if isActiveMember(teamId);
      }
    }

    // --- Collection Group Queries ---
    // Allow users to query their own member documents across all teams
    match /{path=**}/members/{memberId} {
      allow read: if memberId == getCurrentUserId() || 
                      (resource != null && resource.data.uid == getCurrentUserId());
    }
    
    // --- Kart Maintenance MVP Rules ---
    // Note: 'local-user-001' check is for MVP testing only (bypassing Auth)
    
    // Karts: Users can read/write their own karts
    match /karts/{kartId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || request.resource.data.userId == 'local-user-001';
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
    }

    // Maintenance Tasks: Users can read/write tasks for their karts
    match /maintenanceTasks/{taskId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || request.resource.data.userId == 'local-user-001';
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || (resource.data.userId == 'local-user-001' && request.resource.data.userId == 'local-user-001');
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
    }

    // Shopping List Items: Users can read/write their own items
    match /shoppingListItems/{itemId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || request.resource.data.userId == 'local-user-001';
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || (resource.data.userId == 'local-user-001' && request.resource.data.userId == 'local-user-001');
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
    }

    // Session Logs: Users can read/write their own logs
    match /sessionLogs/{logId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || request.resource.data.userId == 'local-user-001';
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || (resource.data.userId == 'local-user-001' && request.resource.data.userId == 'local-user-001');
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || resource.data.userId == 'local-user-001';
    }
  }
}
