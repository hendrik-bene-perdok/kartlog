rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isTeamMember(teamId) {
      let team = get(/databases/$(database)/documents/teams/$(teamId));
      return team != null && (request.auth.uid in team.data.members);
    }

    function isTeamAdmin(teamId) {
      let team = get(/databases/$(database)/documents/teams/$(teamId));
      return team != null && team.data.members[request.auth.uid] == 'owner';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isAuthenticated(); // For initial profile creation
    }

    // --- Teams Collection ---
    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create: if isAuthenticated();
      allow update: if isTeamAdmin(teamId);
      allow delete: if isTeamAdmin(teamId);

      // --- Parts Sub-collection ---
      match /parts/{partId} {
        allow read: if isTeamMember(teamId);
        allow write: if isTeamMember(teamId); // Members can manage parts (Collaborative)
      }

      // --- Sessions Sub-collection ---
      match /sessions/{sessionId} {
        allow read: if isTeamMember(teamId);
        allow write: if isTeamMember(teamId); // Members can log sessions
      }
    }
  }
}
